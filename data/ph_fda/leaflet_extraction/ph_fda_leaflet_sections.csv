PH_FDA_VERIFICATION_PORTAL,DRP-10877-03,Sevelamer Carbonate,Kaycel,PI_01,"Package Insert, Patient Information Leaflet, PI/PIL, Indication, SmPC, SPC",https://drive.google.com/file/d/1H0dwouomlJ6_LZLDhoYgyv6Cplg_aHST/view?usp=drivesdk,pdf/DRP-10877-03_PI_01_https_drive.google.com_file_d_1H0dwouomlJ6_LZLDhoYgyv6Cplg_aHST_view_usp_drivesdk_e35b8887ae.pdf,page_text/DRP-10877-03_PI_01_https_drive.google.com_file_d_1H0dwouomlJ6_LZLDhoYgyv6Cplg_aHST_view_usp_drivesdk_e35b8887ae.json,2bfb2f94e684a6017ab5b2eff631056f0cf9c925ff029f8986a137cef3b33a80,11646015,2,digital_text_and_ocr,,,,,,,,,low,needs_human_review_no_sections_found,2026-06-29T14:39:11.721787+00:00
