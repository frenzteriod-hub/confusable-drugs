PH_FDA_VERIFICATION_PORTAL,DR-XY47295,Cyanocobalamin,G-Cob,PIL_01,"Package Insert, Patient Information Leaflet, PI/PIL, Indication, SmPC, SPC",https://drive.google.com/file/d/1pQ9wYrPHS6YLPGWjN0Dbh5i2HhZ2vD-S/view?usp=drivesdk,pdf/DR-XY47295_PIL_01_https_drive.google.com_file_d_1pQ9wYrPHS6YLPGWjN0Dbh5i2HhZ2vD-S_view_usp_drivesdk_fcb1df4a95.pdf,page_text/DR-XY47295_PIL_01_https_drive.google.com_file_d_1pQ9wYrPHS6YLPGWjN0Dbh5i2HhZ2vD-S_view_usp_drivesdk_fcb1df4a95.json,09e41dac8631e1ef400cb0592d28ad9d38eb008fcce469c0332511f27db5103d,1856290,1,digital_text,"Red coloured, circular, biconvex, film coated tablet.",1,1,PRODUCT DESCRIPTION:,"Vitamin B12 preparations are used in the treatment and prevention of B12 deficiency. Deficiency leads to the development of megaloblastic anaemias, and demyelination and other neurological damage. And treatment of pernicious anaemia.",1,1,INDICATIONS:,high,machine_extracted_review_recommended,2026-06-30T08:25:24.840243+00:00
